{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llm-lab.local/schemas/n2_routing_stats.schema.json",
  "title": "LLM Lab N2 Routing Statistics",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "result_type", "architecture", "collect_stats", "prefill_capacity_factor", "decode_capacity_factor", "stats"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "result_type": {"const": "n2_routing_stats"},
    "architecture": {"const": "MoETransformer"},
    "collect_stats": {"const": true},
    "prefill_capacity_factor": {"const": 1.0},
    "decode_capacity_factor": {"const": 2.0},
    "stats": {"type": "object", "additionalProperties": false, "required": ["prefill", "decode"], "properties": {"prefill": {"$ref": "#/$defs/phase"}, "decode": {"$ref": "#/$defs/phase"}}}
  },
  "$defs": {
    "phase": {"type": "object", "additionalProperties": false, "required": ["num_experts", "capacity_factor", "capacity", "tokens", "assigned_tokens_per_expert", "kept_tokens_per_expert", "dropped_tokens", "dropped_token_ratio", "load_imbalance", "per_layer"], "properties": {"num_experts": {"type": "integer", "minimum": 1}, "capacity_factor": {"type": "number", "exclusiveMinimum": 0}, "capacity": {"type": "integer", "minimum": 1}, "tokens": {"type": "integer", "minimum": 1}, "assigned_tokens_per_expert": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0}}, "kept_tokens_per_expert": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0}}, "dropped_tokens": {"type": "integer", "minimum": 0}, "dropped_token_ratio": {"type": "number", "minimum": 0, "maximum": 1}, "load_imbalance": {"type": "number", "minimum": 1}, "per_layer": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/layer"}}}},
    "layer": {"type": "object", "additionalProperties": false, "required": ["num_experts", "capacity_factor", "capacity", "tokens", "assigned_tokens_per_expert", "kept_tokens_per_expert", "dropped_tokens", "dropped_token_rate", "router_prob_mean"], "properties": {"num_experts": {"type": "integer", "minimum": 1}, "capacity_factor": {"type": "number", "exclusiveMinimum": 0}, "capacity": {"type": "integer", "minimum": 1}, "tokens": {"type": "integer", "minimum": 1}, "assigned_tokens_per_expert": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0}}, "kept_tokens_per_expert": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0}}, "dropped_tokens": {"type": "integer", "minimum": 0}, "dropped_token_rate": {"type": "number", "minimum": 0, "maximum": 1}, "router_prob_mean": {"type": "array", "minItems": 1, "items": {"type": "number", "minimum": 0, "maximum": 1}}}}
  }
}
