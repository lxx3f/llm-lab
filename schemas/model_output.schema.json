{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llm-lab.local/schemas/model_output.schema.json",
  "title": "LLM Lab Model Output",
  "description": "统一记录一次模型生成及其运行上下文。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "model",
    "prompt",
    "response",
    "generation_config",
    "timestamp",
    "experiment_id"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "prompt": {
      "description": "推荐保存实际发送给后端的消息列表；纯文本后端也可使用字符串。",
      "type": ["string", "array"]
    },
    "response": {
      "description": "模型原始响应或统一序列化后的响应。",
      "type": ["string", "object", "array", "null"]
    },
    "generation_config": {
      "type": "object",
      "additionalProperties": true
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "experiment_id": {
      "type": "string",
      "minLength": 1
    },
    "backend": {
      "type": "string",
      "enum": ["transformers", "vllm", "other"]
    },
    "request_id": {
      "type": ["string", "null"]
    },
    "latency_ms": {
      "type": ["number", "null"],
      "minimum": 0
    },
    "usage": {
      "type": ["object", "null"],
      "additionalProperties": true,
      "properties": {
        "prompt_tokens": {"type": "integer", "minimum": 0},
        "completion_tokens": {"type": "integer", "minimum": 0},
        "total_tokens": {"type": "integer", "minimum": 0}
      }
    },
    "error": {
      "type": ["string", "null"]
    }
  }
}
